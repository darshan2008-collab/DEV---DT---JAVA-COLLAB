<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SmartAmbulance" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/medical_blue</item>
        <item name="colorPrimaryVariant">@color/medical_blue_dark</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/signal_green</item>
        <item name="colorSecondaryVariant">@color/signal_green_dark</item>
        <item name="colorOnSecondary">@color/text_white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>
</resources>
